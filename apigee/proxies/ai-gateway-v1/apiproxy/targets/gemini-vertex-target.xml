<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="gemini-vertex-target">
  <Description>Vertex AI Gemini Target Endpoint (Global Location)</Description>
  <FaultRules/>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-RouteGeminiTarget</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <Flows/>
  <EventFlow name="EventFlow" content-type="text/event-stream">
    <Request/>
    <Response>
      <Step>
        <Name>JS-ProcessStreamEvent</Name>
      </Step>
      <Step>
        <Name>LTQ-TokenCount</Name>
        <Condition>flow.stream_done == "true"</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>flow.stream_buff_ready == "true" and flow.stream_partial_text != null and flow.stream_partial_text != ""</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>flow.stream_done == "true"</Condition>
      </Step>
    </Response>
  </EventFlow>
  <HTTPTargetConnection>
    <Properties>
      <Property name="io.timeout.millis">120000</Property>
      <Property name="connect.timeout.millis">10000</Property>
    </Properties>
    <URL>https://aiplatform.googleapis.com</URL>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
